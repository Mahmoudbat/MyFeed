<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is only allowed to the loopback address, where the app's own
  token-protected server streams decrypted vault videos to the player.
  All other cleartext traffic stays blocked.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
